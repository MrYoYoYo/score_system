<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限，用于发送邮件 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 存储权限，用于导入Excel文件 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Score_system">

        <activity
            android:name=".ui.login.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.login.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.score.ShakeActivity" android:exported="false" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.student.StudentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.course.CourseActivity"
            android:exported="false" />

        <activity
            android:name=".ui.score.ScoreActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.backup.BackupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.score.AttendanceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.score.HomeworkActivity"
            android:exported="false" />

        <activity
            android:name=".ui.score.LabActivity"
            android:exported="false" />

        <activity
            android:name=".ui.score.ScoreSummaryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.WeightConfigActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.EmailConfigActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.StatisticsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.score.ScoreAnalysisActivity"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
