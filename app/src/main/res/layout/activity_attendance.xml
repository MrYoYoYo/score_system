<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_course_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="课程名称"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="搜索学生姓名或学号"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_course_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <Spinner
        android:id="@+id/sp_attendance_index"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/til_search" />

    <TextView
        android:id="@+id/tv_student_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="学号"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/btn_next_student"
        app:layout_constraintStart_toEndOf="@+id/btn_previous_student"
        app:layout_constraintTop_toBottomOf="@+id/sp_attendance_index" />

    <TextView
        android:id="@+id/tv_student_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="学生姓名"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/btn_next_student"
        app:layout_constraintStart_toEndOf="@+id/btn_previous_student"
        app:layout_constraintTop_toBottomOf="@+id/tv_student_number" />

    <ImageButton
        android:id="@+id/btn_previous_student"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_pre"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="上一个学生"
        app:layout_constraintBottom_toBottomOf="@+id/tv_student_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_student_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_student_name" />

    <ImageButton
        android:id="@+id/btn_next_student"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_next"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="下一个学生"
        app:layout_constraintBottom_toBottomOf="@+id/tv_student_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_student_name"
        app:layout_constraintTop_toTopOf="@+id/tv_student_name" />

    <Button
        android:id="@+id/btn_present"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:text="到课"
        android:textSize="20sp"
        android:backgroundTint="@android:color/holo_green_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_student_name" />

    <Button
        android:id="@+id/btn_absent"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="缺课"
        android:textSize="20sp"
        android:backgroundTint="@android:color/holo_red_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_present" />

    <LinearLayout
        android:id="@+id/ll_bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_absent">

        <Button
            android:id="@+id/btn_all_present"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="一键全到"
            android:textSize="16sp"
            android:backgroundTint="@android:color/holo_blue_dark" />

        <Button
            android:id="@+id/btn_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="结束点名" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
